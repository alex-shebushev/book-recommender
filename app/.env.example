# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.

# Required: your Anthropic API key (https://console.anthropic.com/).
ANTHROPIC_API_KEY=sk-ant-...

# --- Database ---
# Full connection string for the web API. Host dev reaches the compose Postgres
# on the published port (5544 by default); in the container, compose sets this to
# the internal host (db:5432) instead. If unset, db.py falls back to building it
# from the repo-root .env's POSTGRES_* vars.
DATABASE_URL=postgresql://bookrec:change_me_local_only@localhost:5544/bookrec

# --- Web API auth ---
# Signs the HTTP-only session cookie. Use a strong random value in production.
SESSION_SECRET=dev-insecure-change-me
# Base admin account, seeded by db/seed.py: admin@bookshelf.com / 4R5t6y7u_

# Optional overrides (defaults shown).
AGENT_MODEL=claude-sonnet-4-6
AGENT_MAX_TOKENS=4096
# Adaptive thinking: off by default for this bare loop. Set to 1/true to enable.
AGENT_THINKING=false

# --- "What's my next read?" assistant (tool-using agent) ---
# Prior session messages replayed into context (a turn = 2 messages). Default 5.
AGENT_HISTORY_K=5

# --- find_similar tool (Bedrock Knowledge Base) ---
# AWS credentials AND region come from your AWS CLI config (~/.aws) by default —
# no keys here. Uncomment AWS_REGION only to override your profile's region.
# AWS_REGION=us-east-1
BEDROCK_KB_ID=
# Minimum relevance score (0..1-ish) to keep a hit. Calibrate to your vector
# store — set to 0 to disable filtering while testing.
FIND_SIMILAR_MIN_SCORE=0.4
FIND_SIMILAR_TOP_K=5
