# Copy to `.env` and edit. Do NOT commit `.env`.
POSTGRES_USER=bookrec
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=bookrec
# Host port. 5432 may clash with a locally-installed Postgres, so we publish on
# 5544 by default. The container still listens on 5432 internally.
POSTGRES_PORT=5544

# Host port for the app container's API (maps to container port 8000).
APP_PORT=8000
